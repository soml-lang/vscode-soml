{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"scopeName": "markdown.soml.codeblock",
	"injectionSelector": "L:text.html.markdown - markup.fenced_code.block.markdown - comment - markup.raw.block.markdown - meta.embedded.block.html",
	"patterns": [
		{
			"include": "#soml-code-block"
		}
	],
	"repository": {
		"soml-code-block": {
			"comment": "Fences allow at most three leading spaces after any Markdown container prefix. The outer lookahead and inner begin capture the same fence. The inner while preserves SOML state until that exact fence or a longer run of the same character closes it, even inside an unterminated string or comment. Only backtick fences forbid backticks in the info string.",
			"begin": "(^|\\G)(?=( {0,3})(?=~|`+[^`]*$)((`|~)\\4{2,})[ \\t]*(?i:soml)(?:([ \\t]+|:|,|\\{|\\?).*)?$)",
			"end": "(^|\\G) {0,3}(\\3\\4*)[ \\t]*$",
			"name": "markup.fenced_code.block.markdown",
			"endCaptures": {
				"2": {
					"name": "punctuation.definition.markdown"
				}
			},
			"patterns": [
				{
					"begin": "(^|\\G)( {0,3})(?=~|`+[^`]*$)((`|~)\\4{2,})[ \\t]*(?i:(soml)(([ \\t]+|:|,|\\{|\\?).*)?$)",
					"while": "(^|\\G)(?! {0,3}(\\3\\4*)[ \\t]*$)",
					"contentName": "meta.embedded.block.soml",
					"beginCaptures": {
						"3": {
							"name": "punctuation.definition.markdown"
						},
						"5": {
							"name": "fenced_code.block.language.markdown"
						},
						"6": {
							"name": "fenced_code.block.language.attributes.markdown"
						}
					},
					"patterns": [
						{
							"include": "source.soml"
						}
					]
				}
			]
		}
	}
}
